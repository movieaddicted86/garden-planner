{
  "name": "@garden-planner/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript shared by web and server: geometry, units, material calculation, data model",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test \"src/**/*.test.ts\""
  }
}
